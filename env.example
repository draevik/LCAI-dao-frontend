# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Reown (WalletConnect) Project ID (get from https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_project_id_here

# Alchemy API Key (get from https://alchemy.com)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Contract Addresses (replace with your deployed contracts)
NEXT_PUBLIC_GOVERNOR_CONTRACT=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_TOKEN_CONTRACT=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_TIMELOCK_CONTRACT=0x1234567890123456789012345678901234567890

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_NETWORK_NAME=mainnet

# Optional: IPFS Gateway for metadata storage
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
